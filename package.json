{
  "name": "memopad-new-tab",
  "version": "1.1.4",
  "type": "commonjs",
  "private": true,
  "description": "Save memo in Markdown directly in the 'New Tab' page",
  "author": "",
  "scripts": {
    "serve": "cross-env NODE_OPTIONS=\"--max_old_space_size=2048 \" vue-cli-service serve",
    "build": "cross-env NODE_OPTIONS=\"--max_old_space_size=2048 \" vue-cli-service build",
    "build-legacy": "cross-env NODE_OPTIONS=\"--max_old_space_size=2048 --openssl-legacy-provider\" vue-cli-service build",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint src/js",
    "publish": "cross-env NODE_OPTIONS=\"--max_old_space_size=2048 \" node ./deploy.js",
    "test:e2e": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider\" playwright test",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "jest",
    "test": "jest",
    "test:ci": "jest --coverage",
    "depcruise": "depcruise src/js --config .dependency-cruiser.js",
    "cpd": "jscpd src/js --min-lines 5 --min-tokens 50 --threshold 0",
    "docs": "typedoc --options typedoc.js"
  },
  "dependencies": {
    "@iconify-icons/uil": "^1.2.3",
    "@iconify/vue": "^5.0.0",
    "core-js": "^3.6.5",
    "cross-env": "^7.0.2",
    "filecontainer": "github:nojaja/FileContainer",
    "lodash": "^4.17.23",
    "markdown-it": "^12.3.2",
    "markdown-it-checkbox": "^1.1.0",
    "markdown-it-container": "^3.0.0",
    "markdown-it-emoji": "^1.4.0",
    "markdown-it-multimd-table": "^4.0.3",
    "markdown-it-plantuml": "^1.4.1",
    "markdown-it-ruby": "^0.1.1",
    "monaco-editor": "^0.47.0",
    "monaco-editor-vue3": "^1.0.5",
    "normalize.css": "^8.0.1",
    "splitpanes": "^3.2.0",
    "twemoji": "^13.0.1",
    "vue": "^3.5.33",
    "vue-i18n": "^9.14.5",
    "vuedraggable": "^4.1.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@playwright/test": "1.16.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vue/cli": "^5.0.9",
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-plugin-eslint": "~5.0.9",
    "@vue/cli-plugin-vuex": "^5.0.9",
    "@vue/cli-service": "~5.0.9",
    "@vue/eslint-config-standard": "^8.0.1",
    "@vue/test-utils": "^2.4.10",
    "@vue/vue3-jest": "^29.2.6",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^29.7.0",
    "chrome-webstore-upload": "^0.2.2",
    "copy-webpack-plugin": "^6.1.1",
    "cross-env": "^7.0.2",
    "css-loader": "^7.1.2",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-standard": "^4.0.1",
    "eslint-plugin-vue": "^9.33.0",
    "fdir": "^6.5.0",
    "html-webpack-plugin": "^4.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jscpd": "^4.0.9",
    "mini-css-extract-plugin": "^0.11.2",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "node-sass": "^9.0.0",
    "playwright": "1.16.3",
    "sass-loader": "^10.0.2",
    "ts-jest": "^29.4.9",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1",
    "write-file-webpack-plugin": "^4.5.1",
    "zip-folder": "^1.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "bugs": {
    "url": "https://github.com/nojaja/memopad-new-tab/issues"
  },
  "homepage": "https://github.com/nojaja/memopad-new-tab#readme",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nojaja/memopad-new-tab.git"
  }
}
