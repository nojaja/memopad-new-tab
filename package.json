{
    "name": "memopad-new-tab",
    "version": "1.3.16",
    "type": "commonjs",
    "private": true,
    "description": "Save memo in Markdown directly in the 'New Tab' page",
    "author": "",
    "scripts": {
        "serve": "cross-env NODE_OPTIONS=\"--max_old_space_size=2048\" vite",
        "build": "cross-env NODE_OPTIONS=\"--max_old_space_size=2048\" vite build",
        "postbuild": "node scripts/postbuild.js",
        "lint": "cross-env ESLINT_USE_FLAT_CONFIG=true eslint src/js",
        "test:e2e": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider\" playwright test",
        "type-check": "vue-tsc --noEmit",
        "test:unit": "jest -c jest.unit.config.js",
        "test:spec": "jest -c jest.spec.config.js",
        "test": "jest -c jest.unit.config.js",
        "test:ci": "jest -c jest.coverage.config.js --coverage",
        "depcruise": "depcruise src/js --config .dependency-cruiser.js",
        "cpd": "jscpd src/js --min-lines 5 --min-tokens 50 --threshold 0",
        "docs": "typedoc --options typedoc.js"
    },
    "dependencies": {
        "@iconify-icons/gg": "^1.2.4",
        "@iconify-icons/tdesign": "^1.2.0",
        "@iconify-icons/uil": "^1.2.3",
        "@iconify/vue": "^5.0.0",
        "@nojaja/filecontainer": "^1.0.5",
        "@wekanteam/markdown-it-mermaid": "^0.6.4",
        "core-js": "^3.6.5",
        "cross-env": "^7.0.2",
        "lodash": "^4.18.1",
        "markdown-it": "^14.2.0",
        "markdown-it-container": "^4.0.0",
        "markdown-it-emoji": "^3.0.0",
        "markdown-it-multimd-table": "^4.0.3",
        "markdown-it-plantuml": "^1.4.1",
        "markdown-it-ruby": "^1.1.2",
        "markdown-it-task-checkbox": "^1.0.6",
        "mermaid": "^11.15.0",
        "monaco-editor": "^0.47.0",
        "monaco-editor-vue3": "^1.0.5",
        "normalize.css": "^8.0.1",
        "splitpanes": "^4.0.4",
        "twemoji": "^13.0.1",
        "vue": "^3.5.33",
        "vue-i18n": "^11.4.4",
        "vuedraggable": "^4.1.0",
        "vuex": "^4.1.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.29.0",
        "@babel/preset-typescript": "^7.28.5",
        "@intlify/unplugin-vue-i18n": "^11.2.3",
        "@playwright/test": "1.61.1",
        "@types/jest": "^29.5.14",
        "@types/node": "^25.7.0",
        "@typescript-eslint/eslint-plugin": "^8.59.4",
        "@typescript-eslint/parser": "^8.59.2",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/test-utils": "^2.4.10",
        "@vue/vue3-jest": "^29.2.6",
        "adm-zip": "^0.6.0",
        "babel-eslint": "^10.1.0",
        "babel-jest": "^29.7.0",
        "chrome-webstore-upload": "^6.0.0",
        "cross-env": "^7.0.2",
        "dependency-cruiser": "^17.4.2",
        "eslint": "^8.57.1",
        "eslint-plugin-import": "^2.20.2",
        "eslint-plugin-jsdoc": "^62.9.0",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-sonarjs": "^4.0.3",
        "eslint-plugin-standard": "^5.0.0",
        "eslint-plugin-vue": "^10.9.1",
        "fdir": "^6.5.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jscpd": "^4.0.9",
        "playwright": "^1.59.1",
        "sass": "^1.99.0",
        "ts-jest": "^29.4.9",
        "typedoc": "^0.28.19",
        "typedoc-plugin-markdown": "^4.11.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-plugin-static-copy": "^4.1.0",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^3.2.8"
    },
    "overrides": {
        "braces": "^3.0.3",
        "micromatch": "^4.0.8",
        "cross-spawn": "^7.0.6",
        "postcss": "^8.4.31",
        "uuid": "^14.0.0"
    },
    "browserslist": [
        "last 2 Chrome versions"
    ],
    "bugs": {
        "url": "https://github.com/nojaja/memopad-new-tab/issues"
    },
    "homepage": "https://github.com/nojaja/memopad-new-tab#readme",
    "keywords": [],
    "license": "MIT",
    "repository": {
        "type": "git",
